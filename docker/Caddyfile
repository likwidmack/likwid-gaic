{
	admin off
}

(local_security) {
	tls internal
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}

https://localhost:8443 {
	import local_security
	reverse_proxy localai:8080
}

https://localhost:8444 {
	import local_security
	reverse_proxy private-gpt:8080
}

https://localhost:8445 {
	import local_security
	reverse_proxy stable-diffusion:7860
}

https://localhost:8446 {
	import local_security
	reverse_proxy comfy-frontend:80
}

https://localhost:8447 {
	import local_security
	reverse_proxy comfy-backend:8188
}

# Before binding the gateway to a LAN or VPN address, add authentication here
# or use a reviewed forward-auth provider. Never commit plaintext credentials.
