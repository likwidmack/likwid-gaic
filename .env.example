# Optional Compose overrides. Never put tokens, API keys, or passwords in this
# committed example. Copy to `.env` and adjust paths for your workstation.
# The npm task runner injects fork and storage paths from config/; these matter
# mainly for direct Docker Compose use.

# Compute mode: nvidia (CUDA LocalAI + GPU profiles) or cpu (inference/RAG only).
# Unset defaults to cpu on macOS and nvidia elsewhere. media/comfy require nvidia.
FORKEDAI_COMPUTE=nvidia

# Fork and hub build contexts (absolute or relative to the compose file).
# Windows example: E:/git/_lk/forkedAI and sibling forks under E:/git/
# POSIX example:   ~/git/likwid-gaic and sibling forks under ~/git/
HUB_CONTEXT=.
LOCALAI_CONTEXT=../LocalAI
PRIVATE_GPT_CONTEXT=../private-gpt
STABLE_DIFFUSION_CONTEXT=../stable-diffusion-webui
COMFY_CONTEXT=../ComfyUI
COMFY_FRONTEND_CONTEXT=../ComfyUI_frontend

# --- Network, loopback binding, and HTTPS gateway ports ---
# Keep FORKEDAI_BIND_ADDRESS on 127.0.0.1 unless gateway auth, TLS names,
# firewall rules, and rollback are planned. See docs/network-security.md.
FORKEDAI_EDGE_NETWORK_NAME=forkedai-edge
FORKEDAI_INFERENCE_NETWORK_NAME=forkedai-inference
FORKEDAI_MEDIA_NETWORK_NAME=forkedai-media
FORKEDAI_BIND_ADDRESS=127.0.0.1
LOCALAI_HTTPS_PORT=8443
PRIVATE_GPT_HTTPS_PORT=8444
STABLE_DIFFUSION_HTTPS_PORT=8445
COMFY_HTTPS_PORT=8446
COMFY_API_HTTPS_PORT=8447
CADDY_IMAGE=caddy:2.11.4-alpine

# Storage roots. Prefer durable state, rebuildable cache/scratch, and
# read-mostly shared assets on separate volumes when possible.
# Windows workstation defaults live in config/storage.json (C:/gaic, D:/forkedAI, E:/data/...).
# POSIX defaults (injected by the npm runner): ~/gaic/..., ~/forkedAI/..., ~/data/forkedAI/...
MODEL_ROOT=C:/shared/models
HF_CACHE_ROOT=D:/cache/huggingface
TORCH_CACHE_ROOT=D:/cache/torch
COMFY_TEMP_ROOT=D:/scratch/comfy/temp
MEDIA_ROOT=E:/data/media
DOCUMENT_ROOT=E:/data/documents
RUNTIME_ROOT=E:/data/runtime
SHARED_OBJECT_ROOT=E:/data/shared/objects
TENSOR_ROOT=D:/scratch/tensors
PLUGIN_ROOT=C:/shared/plugins
TOOL_ROOT=C:/shared/tools

# Image and service overrides.
# NVIDIA default (also FORKEDAI_COMPUTE=nvidia):
LOCALAI_IMAGE=localai/localai:v4.8.0-gpu-nvidia-cuda-13
# CPU mode (FORKEDAI_COMPUTE=cpu); the npm runner sets this when unset:
# LOCALAI_IMAGE=localai/localai:v4.8.0
COMFY_BACKEND=http://comfy-backend:8188

# --- GPU and CPU resource tuning (single-GPU workstation defaults) ---
NVIDIA_VISIBLE_DEVICES=0
LOCALAI_MAX_ACTIVE_BACKENDS=1
FORKEDAI_GPU_EXCLUSIVE=true

# --- Privacy defaults (non-secret placeholders) ---
# PrivateGPT uses LocalAI on the private bridge; these are compatibility
# sentinels, not real credentials. Do not set managed LOCALAI_API_KEY here.
OPENAI_API_KEY=localai
OPENAI_EMBEDDING_API_KEY=localai

# PrivateGPT model names must match LocalAI YAML `name` fields (plus :latest).
# Keep embed dim aligned with embed-nomic-v1.5 (768). Optional stronger chat:
# PGPT_LLM_DEFAULT=qwen2.5-7b-instruct:latest after downloading chat-qwen2.5-7b.
PGPT_LLM_DEFAULT=qwen2.5-3b-instruct:latest
PGPT_EMBEDDING_DEFAULT=nomic-embed-text-v1.5:latest
PGPT_EMBED_DIM=768

# Optional thread caps. Do not set these to empty strings in Compose
# environment mappings — LocalAI rejects LOCALAI_THREADS="". Prefer:
#   1) model YAML threads via `npm run models -- sync-localai` with
#      FORKEDAI_CPU_THREADS or LOCALAI_THREADS in the shell, or
#   2) a local compose.override.yaml that sets a real integer, e.g.
#      LOCALAI_THREADS: "20"
# LOCALAI_THREADS=20
# FORKEDAI_CPU_THREADS=20
