PLUGIN_ROOT=E:/data/forkedAI/shared/plugins
TOOL_ROOT=E:/data/forkedAI/shared/tools
LOCALAI_IMAGE=localai/localai:latest-gpu-nvidia-cuda-13
COMFY_BACKEND=http://comfy-backend:8188
