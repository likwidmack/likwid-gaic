{
	admin off
}

# Named snippet (gateway_auth) comes from the mounted runtime file. Default is the
# empty no-op from docker/gateway-auth.empty.caddy (copied by media init).
import /etc/caddy/snippets/gateway-auth.caddy

(local_security) {
	tls internal
	import gateway_auth
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}

# Re-probe Docker DNS after backend recreate; fail_duration clears stale dials
# that otherwise leave https://localhost:8443 stuck on 502.
(bridge_upstream) {
	health_uri {args[0]}
	health_interval 5s
	health_timeout 2s
	health_passes 1
	health_fails 2
	fail_duration 5s
	transport http {
		dial_timeout 3s
	}
}

# Unified OpenAI inference: health-checked LocalAI first, Ollama on 502/503/504.
# Only one engine is healthy on a single-GPU host; both share :8443 for clients.
(inference_upstream) {
	handle_errors {
		reverse_proxy ollama:11434 {
			import bridge_upstream /api/tags
		}
	}
	reverse_proxy localai:8080 {
		import bridge_upstream /readyz
	}
}

# GATEWAY_HOSTNAME defaults to localhost for loopback. Set a LAN/VPN DNS name
# only together with FORKEDAI_BIND_ADDRESS, firewall rules, and basicauth.
https://{$GATEWAY_HOSTNAME:localhost}:8443 {
	import local_security
	handle /v1/models* {
		header Cache-Control "no-store"
		import inference_upstream
	}
	import inference_upstream
}

https://{$GATEWAY_HOSTNAME:localhost}:8444 {
	import local_security
	reverse_proxy private-gpt:8080 {
		import bridge_upstream /v1/models
	}
}

https://{$GATEWAY_HOSTNAME:localhost}:8445 {
	import local_security
	reverse_proxy stable-diffusion:7860 {
		import bridge_upstream /
	}
}

https://{$GATEWAY_HOSTNAME:localhost}:8446 {
	import local_security
	reverse_proxy comfy-frontend:80 {
		import bridge_upstream /
	}
}

https://{$GATEWAY_HOSTNAME:localhost}:8447 {
	import local_security
	reverse_proxy comfy-backend:8188 {
		import bridge_upstream /system_stats
	}
}

https://{$GATEWAY_HOSTNAME:localhost}:8448 {
	import local_security
	reverse_proxy ollama:11434 {
		import bridge_upstream /api/tags
	}
}
